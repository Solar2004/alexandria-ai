{
  "theme": "custom:sol",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/skill-activation-prompt.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/harnesses/iterate/iterate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/artorias/.local/bin/alx hook user-prompt-submit",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/activity-tracker.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/skill-verification-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/activity-tracker.sh",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/post-tool-use-tracker.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/.local/bin/alx hook post-tool-use",
            "timeout": 20
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/skill-activation-tracker.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/activity-tracker.sh",
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/session-doc-updater.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/home/artorias/.local/bin/alx doctor",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/harnesses/iterate/auto-iterate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/harnesses/hooks/research-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/auto-continue.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/activity-tracker.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/harnesses/hooks/system-usage-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/harnesses/iterate/session-reset.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/artorias/.local/bin/alx status",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/artorias/.local/bin/alx evolve",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/artorias/Projectos/AlexanderTheGreat/.claude/hooks/activity-tracker.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}