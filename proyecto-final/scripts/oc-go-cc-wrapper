#!/bin/bash
set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/oc-go-cc"
ENV_FILE="$CONFIG_DIR/env"
STATE_FILE="$CONFIG_DIR/.key_index"
KEYS_FILE="$CONFIG_DIR/api_keys"

if [ ! -f "$KEYS_FILE" ]; then
  cat > "$KEYS_FILE" << 'KEYS'
# oc-go-cc API keys — one per line, cycled on restart
OC_GO_CC_API_KEY_1=***REMOVED***
OC_GO_CC_API_KEY_2=***REMOVED***
KEYS
fi

INDEX=1
if [ -f "$STATE_FILE" ]; then
  INDEX=$(cat "$STATE_FILE")
fi

TOTAL=$(grep -c '^OC_GO_CC_API_KEY_' "$KEYS_FILE" || echo 1)

NEXT=$((INDEX + 1))
if [ "$NEXT" -gt "$TOTAL" ]; then
  NEXT=1
fi
echo "$NEXT" > "$STATE_FILE"

KEY_VAR="OC_GO_CC_API_KEY_$INDEX"
API_KEY=$(grep "^$KEY_VAR=" "$KEYS_FILE" | head -1 | cut -d= -f2-)

export OC_GO_CC_API_KEY="$API_KEY"
export ***REMOVED***="$API_KEY"
echo "OC_GO_CC_API_KEY=$API_KEY" > "$ENV_FILE"

exec "$HOME/.local/bin/routatic-proxy" serve
