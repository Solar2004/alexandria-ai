#!/bin/bash
# ============================================================
#  ATG — AlexanderTheGreat · Claude Code de última generación
#  Wrapper único: aplica headroom (compresión), tema sol/luna
#  y el statusline con datos. Modos:
#    atg            → claude + headroom (recomendado)
#    atg --dangerously-skip-permissions → AUTÓNOMO: lee la misión, elige
#                     trabajo del backlog y ejecuta el ciclo R24 solo
#    atg --auto     → autónomo explícito (igual, sin skip-permissions)
#    atg --no-fallback → solo modelo default con reintentos (sin fallback a hy3/kimi)
#    atg --raw      → claude directo a routatic (sin headroom)
#    atg --free     → claude vía OmniRoute (fallback gratuito)
#    atg --bare     → claude modo minimal (sin plugins/themes)
#  Instalación: Projectos/AlexanderTheGreat/install.sh
# ============================================================
set -euo pipefail

ATGHOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="cc"
HEADROOM=/home/artorias/.local/bin/headroom

# ---------- ALEXANDRIA: si alx está instalado, delega estado/red en él ----------
if command -v alx >/dev/null 2>&1; then
  echo "⚔ ALEXANDRIA: $(alx status) · red: $(alx network 2>/dev/null | sed -n '2p' | cut -d: -f1)" >&2
fi

# atg --alx <subcomando> → delega directamente en ALEXANDRIA
if [ "${1:-}" = "--alx" ]; then
  shift
  exec alx "$@"
fi

# ---------- auto-init: CLAUDE.md si falta (mata el welcome screen + da memoria) ----------
auto_init() {
  [ -f CLAUDE.md ] && return 0
  if [ "$PWD" = "$HOME" ]; then
    # memoria global de usuario: ~/CLAUDE.md se carga en TODOS los proyectos
    [ -f "$HOME/CLAUDE.md" ] && return 0
    cat > "$HOME/CLAUDE.md" <<'EOF'
# Memoria global de usuario (Alexander)

- Idioma: responde en español, directo y sin rodeos.
- Modelo: deepseek-v4-flash vía opencode-go (routatic :3456, headroom :8788).
- Stack del usuario: Arch Linux, kitty, tmux; proyectos en ~/Projectos/.
- Si el proyecto tiene su propio CLAUDE.md, este archivo solo aporta contexto de usuario.
EOF
    echo "atg: ~/CLAUDE.md (memoria global) creado"
    return 0
  fi
  local md="# $(basename "$PWD")

> Generado automaticamente por atg (auto-init). Editalo: es la memoria del proyecto para Claude.

## Stack detectado
$( [ -f package.json ] && echo "- Node.js: \`npm run build\` / \`npm test\` (si existen en package.json)" )
$( [ -f pyproject.toml ] && echo "- Python: \`uv run\` (pyproject.toml presente)" )
$( [ -f requirements.txt ] && echo "- Python: \`pip install -r requirements.txt\`" )
$( [ -f Cargo.toml ] && echo "- Rust: \`cargo build\` / \`cargo test\`" )
$( [ -f go.mod ] && echo "- Go: \`go build ./...\` / \`go test ./...\`" )
$( [ -f Makefile ] && echo "- Make: \`make\` (objetivos en Makefile)" )
$( [ -f docker-compose.yml ] || [ -f compose.yaml ] && echo "- Docker: compose presente" )
$( git rev-parse --git-dir >/dev/null 2>&1 && echo "- Git: rama actual \`$(git branch --show-current 2>/dev/null)\`" )

## Estructura (top-level)
\`\`\`
$( ls -1A | head -25 )
\`\`\`

## Reglas
- Lee el codigo antes de cambiar nada. Pregunta si algo no esta claro.
- Commits: mensajes claros y atoomicos.
"
  printf '%s' "$md" > CLAUDE.md
  echo "atg: CLAUDE.md auto-generado (primer arranque en este directorio)"
}

# ---------- tema sol/luna según hora (06-18 sol, 18-06 luna) ----------
apply_theme() {
  local h=$(date +%H)
  local t="luna"
  [ "$h" -ge 6 ] && [ "$h" -lt 18 ] && t="sol"
  jq --arg t "custom:$t" '.theme = $t' /home/artorias/.claude/settings.json > /tmp/atg-theme.json \
    && mv /tmp/atg-theme.json /home/artorias/.claude/settings.json
  # statusline sol/luna (ccstatusline)
  local src="/home/artorias/Projectos/AlexanderTheGreat/statusline/ccstatus-$t.json"
  [ -f "$src" ] && cp "$src" /home/artorias/.config/ccstatusline/settings.json
}

# ---------- auto-repatch tras updates de Claude Code ----------
ensure_patched() {
  local VDIR=/home/artorias/.local/share/claude/versions
  local BIN=$(ls -1t "$VDIR"/2.* 2>/dev/null | head -1)
  [ -n "$BIN" ] || return 0
  # LOGO (☀) — funciona en la versión actual.
  bash /home/artorias/Projectos/AlexanderTheGreat/scripts/patch-logo.sh "$BIN" >/dev/null 2>&1 || true
  # BRANDING de texto (patch-brand.sh) — "Claude Code" → "ALEXANDRIA " (mismo byte-length, solo display).
  bash /home/artorias/Projectos/AlexanderTheGreat/scripts/patch-brand.sh "$BIN" >/dev/null 2>&1 || true
  # BRANDING completo (patch-cc) — falla en 2.1.231 (entrypoint movido); log silencioso.
  if grep -aq "AlexanderTheGreat" "$BIN" 2>/dev/null; then
    return 0  # ya parchado
  fi
  if HOME=/home/artorias /home/artorias/.local/bin/uvx patch-cc apply --brand "AlexanderTheGreat" --org-label --suffix "atg-build" >/dev/null 2>&1; then
    echo "atg: branding aplicado ✓"
  else
    mkdir -p /home/artorias/.local/logs
    echo "$(date +%Y-%m-%d\ %H:%M) patch-cc no soporta $(basename "$BIN") — branding omitido" >> /home/artorias/.local/logs/atg-patch.log 2>/dev/null || true
  fi
}

auto_init
apply_theme
ensure_patched

# ID de sesión único por lanzamiento → state.toml por sesión (multi-sesión).
export ALX_SESSION_ID="${ALX_SESSION_ID:-$(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s%N)}"
# Desactiva SOLO el gate externo de fact-forcing (ecc:gateguard) que obliga a
# declarar hechos antes de cada edit. Los hooks de ALEXANDRIA siguen activos.
export ECC_GATEGUARD=off

# Contexto real del modelo: CC ve claude-opus-4-6[1m] (1M) vía cc-model-mask; compacta al ~92% de 1M.
# Respeta env pre-existente (modo ahorro: wrapper exporta ANTHROPIC_MODEL sin [1m] + ventana baja).
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-900000}"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-claude-opus-4-6[1m]}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --free)  MODE=free;  shift ;;
    --raw)   MODE=raw;   shift ;;
    --bare)  MODE=bare;  shift ;;
    --clean) MODE=clean; shift ;;
    --auto)  MODE=auto;  shift ;;   # arranque autónomo explícito
    --no-fallback) export ROUTA_NO_FALLBACK=1; shift ;;  # solo modelo default con reintentos
    --help|-h)
      sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) break ;;
  esac
done

# ── Router sin fallback: reintenta solo el modelo default ──
if [[ -n "${ROUTA_NO_FALLBACK:-}" ]]; then
  systemctl --user set-environment ROUTA_NO_FALLBACK=1 2>/dev/null || true
  systemctl --user restart routa-gateway 2>/dev/null || true
  sleep 1
else
  systemctl --user unset-environment ROUTA_NO_FALLBACK 2>/dev/null || true
fi

# ── Arranque autónomo (R29): flags sin prompt ⇒ el motor se pone a trabajar ──
# atg --dangerously-skip-permissions  → lee la misión, elige trabajo del backlog
# y ejecuta el ciclo VERIFICA→CRITICA→MEJORA con commits reales.
if [[ "${MODE}" != "bare" && "${MODE}" != "clean" ]]; then
  HAS_PROMPT=0
  for a in "$@"; do
    if [[ "${a:0:1}" != "-" ]]; then HAS_PROMPT=1; break; fi
  done
  if [[ $HAS_PROMPT -eq 0 && $# -gt 0 ]] || [[ "${MODE}" == "auto" && $HAS_PROMPT -eq 0 ]]; then
    KICKOFF="ARRANQUE AUTÓNOMO del motor ALEXANDRIA. Lee plan/MISSION.md y docs/status.md. Elige AHORA la unidad de trabajo más valiosa: backlog pendiente en plan/ideas.md, mejoras del motor que pida MISSION, o deuda técnica conocida (docs/status.md). Declara tu elección en una frase y EJECUTA el ciclo R24 completo.

FLUJO OBLIGATORIO (no te saltes pasos):
1. PLAN: descompon la tarea en micro-tareas verificables (usa alx feature o TodoWrite).
2. TASKS Y MEMORIA: registra la unidad como task (alx task add) y consulta memoria relevante (alx mcp → memory.recall) antes de codificar; al terminar guarda lección en .alexandria/lessons.md.
3. AGENTE: el hook agent-dispatch ya te sugirió el subagente ideal para tu prompt (mira el contexto adicional) — usa Task con ese agente. Si no hubo sugerencia, elige tú el más adecuado de agents/ o agents-volt/.
4. SKILLS: si la tarea requiere conocimiento especializado (frontend, 3D, testing, infra...) y no tienes la skill en .alexandria/skills/ o ~/.claude/skills/, BÚSCALA ANTES DE CODIFICAR: alx skills-fetch --search \"<tema>\" (ordena por estrellas), puntúala con alx skills-score <dir> y alx skills-challenge <dir>, y si es funcional (INSTALAR/PROBAR) instálala con alx skills-fetch owner/repo. Si el proyecto no tiene .alexandria/, ejecuta alx init primero.
5. PLUGINS: activa los instalados que apliquen (/caveman para commits terse, /ecc para harness, /superpowers para brainstorm si hace falta).
6. DIVISIÓN EN AGENTES: si la tarea es grande o multi-dominio, divide y spawnea subagentes con Task (cada uno con su skill y contexto mínimo) — no hagas todo inline.
7. HARNESSES POR PROYECTO: si detectas un patrón recurrente, un bloqueo que se repite, o una regla que el proyecto debe recordar (ej: “siempre verificar X antes de commit”), FORMALÍZALO: alx harness-new <slug> --objective \"...\" --doc \"...\" --kind temporal --trigger phase:Build. Los harnesses viven en .alexandria/ (por proyecto) y evolucionan solos con alx evolve. Usa alx patterns --apply para minar bloqueos recurrentes.
8. MCP: usa las tools del motor vía MCP (alx mcp) cuando necesites estado real: phalanx.status, governor.cost_report, memory.recall, task.list.
9. EVOLVE: al terminar, valora si lo aprendido merece harness permanente (alx harness-new --kind permanent) o si el watcher lo promoverá solo.
10. IMPLEMENTA → VERIFICA (tests/build reales, nunca 'debería funcionar') → CRITICA → MEJORA → commit atómico.

Repite hasta completar target_iter o agotar el backlog. NO preguntes al usuario salvo bloqueo duro que exija decisión humana."
    set -- "$KICKOFF" "$@"
  fi
fi

case "$MODE" in
  free)
    # OmniRoute en :20128 (traduce Anthropic ↔ OpenAI; fallback multi-provider)
    exec env HOME=/home/artorias ANTHROPIC_BASE_URL=http://127.0.0.1:20128 claude "$@"
    ;;
  raw)
    exec env HOME=/home/artorias ANTHROPIC_BASE_URL=http://127.0.0.1:3456 claude "$@"
    ;;
  bare)
    exec env HOME=/home/artorias claude --bare "$@"
    ;;
  clean)
    # pantalla 100% limpia: -c retoma la sesión del dir o crea sin cabecera
    exec env HOME=/home/artorias ANTHROPIC_BASE_URL=http://127.0.0.1:3456 claude -c "$@"
    ;;
  cc|auto)
    exec env HOME=/home/artorias DISABLE_AUTOUPDATER=1 HEADROOM_BEACON=off ANTHROPIC_AUTH_TOKEN=unused "$HEADROOM" wrap claude --1m --no-proxy --port 8788 --code-memory none --no-mcp -- "$@"
    ;;
esac
